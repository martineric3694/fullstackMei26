<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container py-4">
  <div class="row mb-4">
    <div class="col">
      <h2 class="fw-bold">Dashboard</h2>
      <p class="text-muted">Selamat datang, <strong><%= user.name %></strong>! 👋</p>
    </div>
  </div>

  <div class="row g-4">
    <!-- Card: Produk -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <div class="fs-1 mb-2">🛒</div>
          <h5 class="card-title fw-bold">Manajemen Produk</h5>
          <p class="card-text text-muted flex-grow-1">
            Tambah, ubah, dan hapus produk dengan mudah.
          </p>
          <a href="/products" class="btn btn-primary mt-2">Lihat Produk</a>
        </div>
      </div>
    </div>

    <!-- Card: Tambah Produk -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex flex-column">
          <div class="fs-1 mb-2">➕</div>
          <h5 class="card-title fw-bold">Tambah Produk</h5>
          <p class="card-text text-muted flex-grow-1">
            Daftarkan produk baru ke dalam sistem.
          </p>
          <a href="/products/create" class="btn btn-success mt-2">Tambah Baru</a>
        </div>
      </div>
    </div>

    <!-- Card: Info Akun -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <div class="fs-1 mb-2">👤</div>
          <h5 class="card-title fw-bold">Info Akun</h5>
          <ul class="list-unstyled mt-3">
            <li class="mb-1"><span class="text-muted">Nama:</span> <strong><%= user.name %></strong></li>
            <li class="mb-1"><span class="text-muted">Email:</span> <strong><%= user.email %></strong></li>
            <li>
              <span class="text-muted">Role:</span>
              <span class="badge <%= user.role === 'admin' ? 'bg-warning text-dark' : 'bg-secondary' %>">
                <%= user.role %>
              </span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
